---
import { DESIGN_IDS } from '../../lib/chart';
import { allSeries, primary, runs, scalingSeries, seriesVersionLabel, usingFixture, DATA_URL } from '../../lib/bench';
// What data the dashboard is showing, plus a stat strip and the cross-engine checksum result.
const s = primary;
const dates = s ? s.runs.map((r) => r.date.slice(0, 10)).sort() : [];
const scaling = scalingSeries();
const hosts = s ? [...new Set(s.runs.map((r) => r.host).filter(Boolean))] : [];

// Checksum agreement: for every configuration where two or more engines ran, do the per-policy checksums match?
let agree = 0;
let total = 0;
if (s) {
	for (const c of s.configs) {
		const rs = DESIGN_IDS.map((d) => s.get(d, c.scale, c.shape)).filter((r) => !!r);
		if (rs.length < 2 || rs.some((r) => !r?.checksums)) continue;
		const policies = Object.keys(rs[0]!.checksums!);
		total++;
		if (policies.every((p) => rs.every((r) => r!.checksums![p] === rs[0]!.checksums![p]))) agree++;
	}
}
---

{
	usingFixture && (
		<div class="viz-note">
			<p>
				<strong>Showing the development fixture.</strong> No run files exist in{' '}
				<code>pg_permissions/bench/baselines/data/</code> yet, so the charts use numbers parsed from the saved
				reports in <code>bench/baselines/</code> (the same numbers as COMPARISON.md). Real data replaces the
				fixture automatically at the next <code>npm run sync</code>.
			</p>
		</div>
	)
}
{
	s ? (
		<>
			<div class="viz-stats">
				<div class="viz-stat">
					<div class="label">Dataset</div>
					<div class="value">{s.label}</div>
					<div class="note">{seriesVersionLabel(s)}</div>
				</div>
				<div class="viz-stat">
					<div class="label">Runs</div>
					<div class="value">{s.runs.length}</div>
					<div class="note">
						{s.configs.length} configurations, {runs.length} runs in all series
					</div>
				</div>
				<div class="viz-stat">
					<div class="label">Latest run</div>
					<div class="value">{dates[dates.length - 1]}</div>
					<div class="note">first {dates[0]}</div>
				</div>
				<div class="viz-stat">
					<div class="label">Checksums agree</div>
					<div class="value">
						{agree} of {total}
					</div>
					<div class="note">configurations: identical visible ids on A, B and C</div>
				</div>
			</div>
			<p>
				Charts use <strong>{s.label}</strong>
				{hosts.length > 0 && <>{' '}on {hosts.join('; ')}</>}: Postgres {s.versions.join(', ')}, the latest run per engine, scale
				and shape. This is the primary series, chosen on purpose: Docker, the newest Postgres version, and the
				optimized engines when their runs exist (otherwise the newest Docker series, then local).{' '}
				{s.runs[0]?.clients && <>{s.runs[0].clients} pgbench clients, {s.runs[0].duration_s} s per workload. </>}
				Docker runs cover the large default, medium deep and medium wide configurations only.
				{scaling && scaling !== s && (
					<> The small and medium default scales exist only for <strong>{scaling.label}</strong>, so the scaling chart uses that series and says so.</>
				)}{' '}
				Charts never mix environments or tags in one figure. Series in the data: {allSeries.map((x) => x.label).join('; ')}.
				Compare Postgres versions on the <a href={'../postgres-versions/'}>Postgres versions page</a> and the before and
				after of the optimization pass on the <a href={'../optimizations/'}>Optimizations page</a>. All latencies are
				milliseconds; one run per configuration, so differences under about 20% are noise. Run files live in{' '}
				<a href={DATA_URL}>bench/baselines/data</a>.
			</p>
		</>
	) : (
		<div class="viz-note">
			<p>No benchmark data found (neither real runs nor the fixture).</p>
		</div>
	)
}
