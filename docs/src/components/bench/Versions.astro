---
import Frame from '../viz/Frame.astro';
import Legend from '../viz/Legend.astro';
import TabGroup from '../viz/TabGroup.astro';
import ColPanel from '../viz/ColPanel.astro';
import { allSeries, usingFixture, workloadInfo, workloadNames, p50, DATA_URL, times } from '../../lib/bench';
import type { Series } from '../../lib/bench';
import { engine, fmt, logDomain } from '../../lib/chart';
import type { Design } from '../../lib/chart';

const KEY = ['rbac_check', 'share_select_page', 'parents_proj_select_page', 'parents_select_page', 'write_nest_team', 'nest_check'];
const DESIGNS = ['a', 'b', 'c'] as Design[];
const majors = [...new Set(allSeries.map((s) => s.major))].sort((a, b) => a - b);

// union of configurations across series, in the usual order
const order = ['large-default', 'medium-default', 'small-default', 'medium-deep', 'medium-wide'];
const configMap = new Map<string, { scale: string; shape: string; label: string; series: Series[] }>();
for (const s of allSeries)
	for (const c of s.configs) {
		const k = `${c.scale}-${c.shape}`;
		if (!configMap.has(k)) configMap.set(k, { scale: c.scale, shape: c.shape, label: c.label, series: [] });
		configMap.get(k)!.series.push(s);
	}
const configs = [...configMap.entries()]
	.sort((a, b) => (order.indexOf(a[0]) + 100) % 100 - (order.indexOf(b[0]) + 100) % 100)
	.map(([key, c]) => ({ key, ...c }));

function panelsFor(c: (typeof configs)[number]) {
	return KEY.map((name) => ({
		name,
		info: workloadInfo(name),
		groups: c.series
			.map((s) => ({
				label: s.label,
				cols: DESIGNS.map((d) => ({ design: d, value: p50(s.get(d, c.scale, c.shape), name) })).filter((x) => x.value != null) as { design: Design; value: number }[],
			}))
			.filter((g) => g.cols.length),
	})).filter((p) => p.groups.length);
}

// takeaway: biggest relative gap between Postgres majors, only between series on the same environment
// (local against docker would confound the version with the machine).
let takeaway = '';
type Best = { name: string; d: Design; hi: Series; lo: Series; r: number; vhi: number; vlo: number; cfg: string };
if (majors.length < 2) {
	const only = allSeries.map((s) => s.label).join(', ');
	takeaway = allSeries.length ? `Only ${only} is available so far, so there is nothing to compare yet. Charts below show that single series and will gain a column per version as runs are added.` : '';
} else {
	let best: Best | undefined;
	let pairs = 0;
	for (const c of configs)
		for (const name of KEY)
			for (const d of DESIGNS) {
				const vals = c.series
					.map((s) => ({ s, v: p50(s.get(d, c.scale, c.shape), name) }))
					.filter((x): x is { s: Series; v: number } => x.v != null);
				for (const x of vals)
					for (const y of vals) {
						if (x.s.environment !== y.s.environment || x.s.major >= y.s.major) continue;
						pairs++;
						const r = Math.max(x.v, y.v) / Math.min(x.v, y.v);
						if (!best || r > best.r)
							best = { name, d, hi: x.v > y.v ? x.s : y.s, lo: x.v > y.v ? y.s : x.s, r, vhi: Math.max(x.v, y.v), vlo: Math.min(x.v, y.v), cfg: c.label };
					}
			}
	if (!best)
		takeaway = `No two Postgres versions share an environment and a configuration yet (${allSeries.map((s) => s.label).join(', ')}), so versions cannot be compared like for like. Local against Docker would mix the version with the machine.`;
	else
		takeaway =
			best.r < 1.2
				? `Compared within one environment (${pairs} workload pairs), no key workload differs by more than about 20% between Postgres versions.`
				: `Compared within one environment, the largest gap between versions is ${workloadInfo(best.name).title} on ${engine(best.d).letter} (${best.cfg}): ${fmt(best.vlo)} ms on ${best.lo.label} against ${fmt(best.vhi)} ms on ${best.hi.label} (${times(best.r)}). Gaps under about 20% are within noise.`;
}
---

{
	usingFixture && (
		<div class="viz-note">
			<p>
				<strong>Showing the development fixture.</strong> It is a single local PG 16 series parsed from the saved
				reports. Docker runs for pg16, pg17 and pg18 will appear here once their files are in{' '}
				<code>pg_permissions/bench/baselines/data/</code>.
			</p>
		</div>
	)
}

{
	allSeries.length ? (
		<>
			<div class="viz-note">
				<p>
					{majors.length === 1 ? (
						<>
							<strong>Only PG {majors[0]} is available so far</strong> ({allSeries.map((s) => s.label).join(', ')}).
							Versions are compared as soon as runs for another Postgres major version exist in the data.
						</>
					) : (
						<>
							<strong>
								{majors.length} Postgres versions available: {majors.map((m) => `PG ${m}`).join(', ')}.
							</strong>{' '}
							Each series is one Postgres major version on one environment; the latest run per engine, scale and shape is used.
						</>
					)}
				</p>
			</div>

			<div class="sl-markdown-content">
				<table>
					<thead>
						<tr><th>Series</th><th>Postgres</th><th>Runs</th><th>Engines</th><th>Configurations</th><th>Host</th></tr>
					</thead>
					<tbody>
						{allSeries.map((s) => (
							<tr>
								<td>{s.label}</td>
								<td>{s.versions.join(', ')}</td>
								<td>{s.runs.length}</td>
								<td>{[...new Set(s.runs.map((r) => r.design.toUpperCase()))].sort().join(', ')}</td>
								<td>{s.configs.map((c) => c.label).join(', ')}</td>
								<td>{[...new Set(s.runs.map((r) => r.host).filter(Boolean))].join('; ')}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<Frame
				title="p50 latency by Postgres version"
				subtitle="Key workloads, one panel each; columns are engines, groups are Postgres versions. Log axis, milliseconds."
				takeaway={takeaway}
				source={[{ href: DATA_URL, label: 'bench/baselines/data' }]}
			>
				<Legend slot="legend" />
				<TabGroup tabs={configs.map((c) => ({ key: c.key, label: c.label }))} label="Scale and shape">
					{configs.map((c) => (
						<div data-tab={c.key}>
							<p class="viz-tabpanel-title">{c.label}</p>
							<div class="viz-panels">
								{panelsFor(c).map((p) => (
									<div>
										<p class="viz-panel-title">{p.info.title}</p>
										<p class="viz-panel-sub">{p.name}</p>
										<ColPanel groups={p.groups} unit="ms" title={`${p.info.title}, p50 by Postgres version, ${c.label}`} />
									</div>
								))}
							</div>
							<details>
								<summary>Table view: {c.label}, all workloads</summary>
								<div class="tbl-wrap">
									<table>
										<thead>
											<tr>
												<th>Workload (p50 ms)</th>
												{c.series.flatMap((s) => DESIGNS.map((d) => <th>{s.label} {engine(d).letter}</th>))}
											</tr>
										</thead>
										<tbody>
											{workloadNames(c.series.flatMap((s) => DESIGNS.map((d) => s.get(d, c.scale, c.shape)).filter((r) => !!r)) as any)
												.map((name) => (
													<tr>
														<td>{workloadInfo(name).title}</td>
														{c.series.flatMap((s) => DESIGNS.map((d) => <td>{fmt(p50(s.get(d, c.scale, c.shape), name))}</td>))}
													</tr>
												))}
										</tbody>
									</table>
								</div>
							</details>
						</div>
					))}
				</TabGroup>
			</Frame>
		</>
	) : (
		<div class="viz-note"><p>No benchmark data found.</p></div>
	)
}
