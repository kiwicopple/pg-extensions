# Optional. Leave both unset for the browser-only counter preview.
# Copy to .env for local development, then uncomment and fill in both values.
# CRDT_DEMO_DATABASE_URL=postgresql://crdt_demo_app:URL_ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# CRDT_DEMO_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
# Optional provider CA, copied from the provider's certificate download.
# Supports multiline PEM or escaped newlines in a double-quoted value.
# CRDT_DEMO_DATABASE_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Optional setup account for installing the demo schema and runtime role.
# Local only: do not put this account in Vercel or use it for the demo API.
# CRDT_DEMO_SETUP_DATABASE_URL=postgresql://SETUP_USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
