---
import Frame from '../viz/Frame.astro';
import Legend from '../viz/Legend.astro';
import Dumbbell from '../viz/Dumbbell.astro';
import { BASELINES_URL } from '../../lib/bench';
import { fmt } from '../../lib/chart';
import { RBAC_CASES, MAIN_MAJOR, allChanges, caseConfig, dumbbellRows, beforeAfterText, pairFor } from '../../lib/optimizations';

const pair = pairFor(MAIN_MAJOR);
const rows = dumbbellRows(pair, RBAC_CASES);
const ch = allChanges(RBAC_CASES);
const moved = ch.filter((x) => x.dir !== 'same');
const worst = [...ch].sort((a, b) => Math.abs(Math.log(b.r)) - Math.abs(Math.log(a.r)))[0];
const slower = ch.filter((x) => x.r < 1);
const slowerBy = Math.max(0, ...slower.map((x) => x.after - x.before));
const takeaway = ch.length
	? `${ch.length - moved.length} of ${ch.length} RBAC measurements (5 workloads, 3 designs) are within 20% of their old value; ${moved.length ? `${moved.length} moved by more than that` : 'none moved more than that'}. ` +
		`The largest relative change is ${worst.design.toUpperCase()} ${worst.c.key}: ${fmt(worst.before)} to ${fmt(worst.after)} ms. ` +
		`${slower.length} of ${ch.length} got slower, by at most ${fmt(slowerBy)} ms; the optimizations target sharing, parents and nesting, so RBAC is the control group.`
	: '';
---

{
	rows.length ? (
		<Frame
			title="RBAC workloads, before and after"
			subtitle={`Control group, ${beforeAfterText(pair)}. Large default. p50 in milliseconds on a log axis; the dots overlap when nothing changed.`}
			takeaway={takeaway}
			source={[{ href: BASELINES_URL, label: 'per-run reports' }]}
		>
			<Legend slot="legend" extra={[{ label: 'before', kind: 'before' }, { label: 'after', kind: 'after' }]} />
			<Dumbbell rows={rows} unit="ms" context="p50 latency before and after the optimizations, RBAC workloads, by design" />
			<Fragment slot="table">
				<table>
					<thead>
						<tr><th>Workload</th><th>Design</th><th>Before p50 ms</th><th>After p50 ms</th><th>Change</th></tr>
					</thead>
					<tbody>
						{ch.map((x) => (
							<tr><td>{x.c.key} ({caseConfig(x.c)})</td><td>{x.design.toUpperCase()}</td><td>{fmt(x.before)}</td><td>{fmt(x.after)}</td><td>{x.text}</td></tr>
						))}
					</tbody>
				</table>
			</Fragment>
		</Frame>
	) : null
}
