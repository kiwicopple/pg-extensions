{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix site ci",
  "buildCommand": "npm run docs:build",
  "outputDirectory": "site/dist",
  "redirects": [
    {
      "source": "/research/overview",
      "destination": "https://kiwicopple.github.io/pg-extensions/pg_permissions/",
      "permanent": true
    },
    {
      "source": "/research/overview/",
      "destination": "https://kiwicopple.github.io/pg-extensions/pg_permissions/",
      "permanent": true
    },
    {
      "source": "/research",
      "destination": "https://kiwicopple.github.io/pg-extensions/pg_permissions/",
      "permanent": true
    },
    {
      "source": "/research/",
      "destination": "https://kiwicopple.github.io/pg-extensions/pg_permissions/",
      "permanent": true
    },
    {
      "source": "/research/:path(.*)",
      "destination": "https://kiwicopple.github.io/pg-extensions/pg_permissions/:path",
      "permanent": true
    },
    {
      "source": "/markdown/research/overview.md",
      "destination": "https://kiwicopple.github.io/pg-extensions/pg_permissions/",
      "permanent": true
    },
    {
      "source": "/markdown/research/:path*.md",
      "destination": "https://kiwicopple.github.io/pg-extensions/pg_permissions/:path*/",
      "permanent": true
    }
  ],
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- .; then echo \"No project changes; skipping build\"; exit 0; else echo \"Project changed or comparison unavailable; building\"; exit 1; fi"
}
